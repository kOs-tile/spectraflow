# ── Upstream LLM Provider ────────────────────────────────────────────────────
# Your actual OpenAI (or compatible) API key — SPECTRAFLOW forwards it to the upstream
OPENAI_API_KEY=sk-your-key-here
UPSTREAM_BASE_URL=https://api.openai.com/v1

# For Anthropic Claude (optional alternate provider)
ANTHROPIC_API_KEY=

# For DeepSeek (optional alternate provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TIMESCALEDB_URL=postgresql://spectraflow:spectraflow@localhost:5432/spectraflow
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CUSUM Drift Detection ────────────────────────────────────────────────────
# h: alarm threshold — lower = more sensitive (default: 5.0)
CUSUM_THRESHOLD_H=5.0
# k: allowable slack (reference value) — typically 0.5 * expected shift (default: 0.5)
CUSUM_SLACK_K=0.5
# How often the drift monitor Celery task runs (seconds)
DRIFT_MONITOR_INTERVAL=300

# ── Behavioral Baseline ──────────────────────────────────────────────────────
# Rolling window for centroid/variance computation
BASELINE_WINDOW_DAYS=7
# Minimum samples required before baseline is considered stable
BASELINE_MIN_SAMPLES=50

# ── Semantic Fingerprinting ───────────────────────────────────────────────────
# Embedding model for fingerprinting (uses OpenAI embeddings API)
EMBEDDING_MODEL=text-embedding-3-small
# Qdrant collection name
QDRANT_COLLECTION=spectraflow_fingerprints

# ── Proxy Behavior ───────────────────────────────────────────────────────────
# Timeout for upstream LLM calls (seconds)
UPSTREAM_TIMEOUT=120
# Max retries on upstream failure
UPSTREAM_MAX_RETRIES=2
# Whether to pass through unknown endpoints (passthrough mode)
PROXY_PASSTHROUGH_UNKNOWN=true
# Telemetry content policy: metadata | response | full
# Default "response" preserves semantic drift analysis without storing user prompts.
TELEMETRY_CONTENT_MODE=response

# ── Root Cause Agent ─────────────────────────────────────────────────────────
# Model used by the root cause analysis agent
ROOT_CAUSE_MODEL=gpt-4o
# Max samples to compare when analyzing drift
ROOT_CAUSE_SAMPLE_SIZE=20

# ── Regression Test Synthesizer ──────────────────────────────────────────────
TEST_SYNTHESIS_MODEL=gpt-4o
# How many production inputs to sample for test generation
TEST_SYNTHESIS_SAMPLE_SIZE=50
# Minimum behavioral similarity score to include in golden tests
TEST_SYNTHESIS_MIN_SCORE=0.85

# ── Telemetry Stream ─────────────────────────────────────────────────────────
REDIS_STREAM_KEY=spectraflow:telemetry
REDIS_STREAM_GROUP=spectraflow-consumers
REDIS_STREAM_CONSUMER=consumer-1
# Max events per consumer batch read
REDIS_STREAM_BATCH_SIZE=100

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── API Security ─────────────────────────────────────────────────────────────
# Optional: protect the management API with a bearer token
# SPECTRAFLOW_API_KEY=your-management-key-here
